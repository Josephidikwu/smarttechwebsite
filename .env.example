# Copy to .env.local for local development. See docs/SETUP.md for how to get each value.

# Neon Postgres connection string (Neon dashboard → your project → Connection Details)
DATABASE_URL=

# Vercel Blob — auto-populated by `vercel env pull` once a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# 32-byte key, base64-encoded — generate with: openssl rand -base64 32
# Encrypts the SMTP password saved from /admin/settings/email. Losing this key
# means re-entering the webmail password; never commit it.
SETTINGS_ENCRYPTION_KEY=

# Cloudflare Turnstile (anti-spam widget) — dashboard.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Inbox that receives "new submission" notifications for every pipeline
ADMIN_NOTIFICATION_EMAIL=

# Public site URL — no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
