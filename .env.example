# Copy to .env.local for local development. See docs/SETUP.md for how to get each value.
#
# Only genuine infrastructure/bootstrapping values live here. Everything a
# non-technical admin might reasonably change — GA4 ID, Turnstile keys, the
# notification inbox, webmail/SMTP — is configured from the admin dashboard
# (Settings -> Integrations / Settings -> Email) and stored in the database,
# not as an env var.

# Neon Postgres connection string (Neon dashboard → your project → Connection Details)
DATABASE_URL=

# Vercel Blob — auto-populated by `vercel env pull` once a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# 32-byte key, base64-encoded — generate with: openssl rand -base64 32
# Encrypts the SMTP password (Settings -> Email) and the Turnstile secret key
# (Settings -> Integrations) at rest. Losing this key means re-entering both;
# never commit it.
SETTINGS_ENCRYPTION_KEY=

# Public site URL — no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
