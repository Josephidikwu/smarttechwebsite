# Local dev only — copy to .env.local for `next dev` (Next.js reads this
# directly). The deployed Worker gets non-secret values from the `vars`
# block in wrangler.jsonc instead, and secrets via `wrangler secret put`
# (production) / `.dev.vars` (local `wrangler dev`/preview) — never from
# this file in production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Create a GA4 property and paste its Measurement ID (G-XXXXXXX) here — see
# docs open items in the build plan.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Turnstile site key is public/client-safe. The matching secret key goes in
# .dev.vars (local) / `wrangler secret put TURNSTILE_SECRET_KEY` (prod) —
# never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
